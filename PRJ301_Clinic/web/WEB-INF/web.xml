<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>PRJ301 Clinic Spa Appointment System</display-name>

    <!-- =================================================================== -->
    <!-- 1. BỘ LỌC HỆ THỐNG (FILTER CHAINING - THỨ TỰ BẮT BUỘC TỪ TRÊN XUỐNG) -->
    <!-- 1. EncodingFilter  -> Ép UTF-8 & nạp ClinicSettings toàn cục         -->
    <!-- 2. XSSFilter       -> Lọc mã độc tấn công XSS trên tham số input     -->
    <!-- 3. CSRFTokenFilter -> Sinh và xác thực mã CSRF Token                 -->
    <!-- 4. TransactionFilter -> Quản lý vòng đời DB Connection & Commit/Rollback -->
    <!-- 5. AuthenticationFilter -> Kiểm tra phiên Session & Phân quyền       -->
    <!-- =================================================================== -->

    <!-- 1.1. EncodingFilter (UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 1.2. XSSFilter (Anti-XSS Request Wrapper) -->
    <filter>
        <filter-name>XSSFilter</filter-name>
        <filter-class>filter.XSSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>XSSFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 1.3. CSRFTokenFilter (CSRF Guard) -->
    <filter>
        <filter-name>CSRFTokenFilter</filter-name>
        <filter-class>filter.CSRFTokenFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CSRFTokenFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 1.4. TransactionFilter (ThreadLocal Connection & Auto Commit/Rollback) -->
    <filter>
        <filter-name>TransactionFilter</filter-name>
        <filter-class>filter.TransactionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>TransactionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 1.5. AuthenticationFilter (Session Guard & Access Control) -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- =================================================================== -->
    <!-- 2. CẤU HÌNH PHIÊN LÀM VIỆC (SESSION CONFIG)                        -->
    <!-- =================================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- =================================================================== -->
    <!-- 3. TRANG KHỞI ĐỘNG MẶC ĐỊNH (WELCOME FILES)                         -->
    <!-- =================================================================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>MainController</welcome-file>
    </welcome-file-list>

    <!-- =================================================================== -->
    <!-- 4. KHAI BÁO SERVLET MAPPINGS TƯỜNG MINH (HYBRID ARCHITECTURE)       -->
    <!-- Đảm bảo 100% tương thích cả khi Tomcat tắt tính năng Annotation Scan-->
    <!-- =================================================================== -->

    <!-- 4.1. Điều hướng chính (Main Dispatcher) -->
    <servlet>
        <servlet-name>MainController</servlet-name>
        <servlet-class>controller.MainController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MainController</servlet-name>
        <url-pattern>/MainController</url-pattern>
        <url-pattern>/main</url-pattern>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- 4.2. Đăng nhập (Login) -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 4.3. Đăng ký (Register) -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- 4.4. Đăng xuất (Logout) -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 4.5. Quên mật khẩu (Forgot Password) -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>controller.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <!-- 4.6. Hồ sơ cá nhân (Profile) -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- 4.7. Lịch sử khám bệnh (Medical History) -->
    <servlet>
        <servlet-name>HistoryServlet</servlet-name>
        <servlet-class>controller.HistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HistoryServlet</servlet-name>
        <url-pattern>/history</url-pattern>
    </servlet-mapping>

    <!-- 4.8. Đặt lịch khám & Thanh toán (Booking & Payment) -->
    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>controller.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/booking</url-pattern>
    </servlet-mapping>

    <!-- 4.9. Phân hệ Bác sĩ (Doctor Dashboard) -->
    <servlet>
        <servlet-name>DoctorServlet</servlet-name>
        <servlet-class>controller.DoctorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorServlet</servlet-name>
        <url-pattern>/doctor/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 4.10. Phân hệ Lễ tân (Receptionist Dashboard) -->
    <servlet>
        <servlet-name>ReceptionistServlet</servlet-name>
        <servlet-class>controller.ReceptionistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceptionistServlet</servlet-name>
        <url-pattern>/receptionist/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 4.11. Phân hệ Quản trị viên (Admin Dashboard) -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 4.12. Webhook SePay Tự động (SePay Payment Webhook) -->
    <servlet>
        <servlet-name>SepayWebhookServlet</servlet-name>
        <servlet-class>controller.SepayWebhookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SepayWebhookServlet</servlet-name>
        <url-pattern>/sepay-webhook</url-pattern>
    </servlet-mapping>

    <!-- =================================================================== -->
    <!-- 5. ĐIỀU HƯỚNG TRANG BÁO LỖI TOÀN CỤC (GLOBAL ERROR PAGES)           -->
    <!-- =================================================================== -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/views/error/400.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- =================================================================== -->
    <!-- 6. CẤU HÌNH MIME TYPE UTF-8 CHO STATIC ASSETS                       -->
    <!-- =================================================================== -->
    <mime-mapping>
        <extension>js</extension>
        <mime-type>text/javascript;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css;charset=UTF-8</mime-type>
    </mime-mapping>

</web-app>

<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>PRJ301 Clinic Spa Appointment System</display-name>

    <!-- 1. Cấu hình Session Timeout (30 Phút) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- 2. Cấu hình Trang Khởi động Mặc định (Welcome Files) -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>MainController</welcome-file>
    </welcome-file-list>

    <!-- 3. Cấu hình Cặp Trang Lỗi Tập trung (Global Error Page Mapping) -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

</web-app>
